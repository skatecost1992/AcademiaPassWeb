{
  "expo": {
    "name": "AcademiaPass",
    "slug": "academiapass-web",
    "scheme": "academiapass",
    "version": "1.0.16",
    "platforms": [
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F1F5F4"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AcademiaPass usa la cámara para leer el código QR de los clientes y tomar fotos de sedes y espacios."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AcademiaPass necesita tus fotos para cargar imágenes de sedes y espacios.",
          "cameraPermission": "AcademiaPass usa la cámara para tomar fotos de sedes y espacios."
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "apiUrlCloud": "https://academiapass-yz2l.onrender.com",
      "apiUrlLocal": "http://192.168.1.173:8080",
      "defaultServer": "cloud",
      "cloudDatabase": "PostgreSQL en Neon",
      "localDatabase": "SQL Server · DESKTOP-FODDHQ6 / AcademiaPass"
    }
  }
}
